[Unit]
Description=Keep manager tender workbook up to date during the workday

[Timer]
OnCalendar=*-*-* *:00:00 Europe/Moscow
OnCalendar=*-*-* *:15:00 Europe/Moscow
OnCalendar=*-*-* *:30:00 Europe/Moscow
OnCalendar=*-*-* *:45:00 Europe/Moscow
Persistent=true
Unit=tender-search-manager-sync.service

[Install]
WantedBy=timers.target
