[Unit]
Description=Keep manager tender workbook up to date during the workday

[Timer]
# Keep the 15-minute cadence, offset from the priority 05:00 daily collection
# so both services can never race for their first lock acquisition.
OnCalendar=*-*-* *:02:00 Europe/Moscow
OnCalendar=*-*-* *:17:00 Europe/Moscow
OnCalendar=*-*-* *:32:00 Europe/Moscow
OnCalendar=*-*-* *:47:00 Europe/Moscow
Persistent=true
Unit=tender-search-manager-sync.service

[Install]
WantedBy=timers.target
