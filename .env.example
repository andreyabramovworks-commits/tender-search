POSTGRES_DB=tender_search
POSTGRES_USER=tender_search
# Use a randomly generated hexadecimal password; never commit the real .env.
POSTGRES_PASSWORD=replace_with_random_hex
GOOGLE_SPREADSHEET_ID=1-bZ7tvZ2f0yGy8_lue_v8nrWJh-3xGqCvAEZATn6X2g
GOOGLE_SHEET_TITLE=Тендеры
TENDER_ROOT=/opt/tender-search
REQUEST_DELAY_SECONDS=1.5
HTTP_TIMEOUT_SECONDS=60
SEARCH_MODES=Pro,Standard
SEARCH_SCOPES=title
PAGE_SIZE=100
MAX_PAGES=100
# For local execution outside Docker:
# DATABASE_URL=postgresql+psycopg://tender_search:PASSWORD@127.0.0.1:5432/tender_search
# TENDERLAND_CREDENTIALS_FILE=.secrets/tenderland.json
# GOOGLE_APPLICATION_CREDENTIALS=.secrets/google-service-account.json
